# Copy this file to .env locally. Never commit .env or paste keys into the UI.
# Node.js >=20.12 is required; no npm dependencies are needed.
# The provider must support OpenAI-compatible Chat Completions + function tools.
# Verified provider: Bailian Beijing, qwen-plus (non-thinking by default).
# Copy the OpenAI-compatible Base URL from your Beijing workspace console.
# Example SHAPE: https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Supply the base URL WITHOUT /chat/completions. An empty key disables live AI.
AI_BASE_URL=
AI_MODEL=qwen-plus
AI_API_KEY=
PORT=4173
